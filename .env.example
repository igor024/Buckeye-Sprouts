# Optional: the initial scaffold always uses seeded, in-memory feature services.
# Workstreams can replace each mock adapter independently using this client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Explicit opt-in for ephemeral, process-local session creation in judge demos.
# Session creation fails closed whenever either Supabase setting above is present.
BUCKEYESPROUTS_DEMO_MODE=false

# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# AI routes are deterministic stubs until auth + provider calls are implemented.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
